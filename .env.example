# Copy to your hosting provider's Environment Variables section.
# DO NOT commit a filled-in version of this file to GitHub.

# Your live website URL(s) allowed to call the API (comma-separated). Never use *
ALLOWED_ORIGINS=https://kgnpowertools.netlify.app

# Long random string. Generate with:  openssl rand -hex 24
# If left blank, all /api/admin endpoints are blocked (safe default).
ADMIN_API_KEY=

# Optional: persistent Postgres (e.g. free Neon). Leave unset to use in-memory H2.
# SPRING_DATASOURCE_URL=jdbc:postgresql://HOST:5432/DBNAME?sslmode=require
# SPRING_DATASOURCE_USERNAME=your_db_user
# SPRING_DATASOURCE_PASSWORD=your_db_password

SPRING_DATASOURCE_URL=jdbc:postgresql://HOST:5432/DBNAME?sslmode=require
SPRING_DATASOURCE_USERNAME=your_db_user
SPRING_DATASOURCE_PASSWORD=your_db_password

# Optional tuning
RATE_LIMIT_PER_MIN=20
